@'
# ============================================
# Copiar a .env y completar:  cp .env.example .env
# El archivo .env NUNCA se versiona.
# ============================================

# --- Entorno ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Autenticación (Clase 14) ---
# Generar uno largo y aleatorio. No reutilizar entre entornos.
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_ISSUER=rag-owasp
JWT_AUDIENCE=rag-owasp-api
JWT_TTL_SECONDS=3600

# --- Rate limiting (Clase 14) ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHARS=20000

# --- Guardrails ---
MAX_QUESTION_CHARS=1000

# --- RAG ---
CORPUS_DIR=data/corpus
INDEX_DIR=data/index
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDINGS_PROVIDER=hashing

# --- LLM ---
# stub = no sale a la red (para desarrollo y CI, sin secretos)
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30

# --- Observabilidad (Clase 15) ---
# Por defecto NO se loguea el texto de los prompts.
LOG_PROMPTS=false
'@ | Set-Content -Path .env.example -Encoding utf8
@'

# --- Entorno ---
ENVIRONMENT=dev
LOG_LEVEL=INFO

# --- Autenticación ---
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_ISSUER=rag-owasp
JWT_AUDIENCE=rag-owasp-api
JWT_TTL_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHARS=20000

# --- Guardrails ---
MAX_QUESTION_CHARS=1000

# --- RAG ---
CORPUS_DIR=data/corpus
INDEX_DIR=data/index
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Embeddings ---
EMBEDDINGS_PROVIDER=hashing

# --- LLM ---
LLM_PROVIDER=stub
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=600
LLM_TIMEOUT_SECONDS=30

# --- Observabilidad ---
LOG_PROMPTS=false
'@ | Set-Content -Path .env.example -Encoding utf8